/* pages/partners/partners.wxss */
.partner-hero {
  background: #092d39;
  color: #f8f6ef;
  padding: 36rpx 30rpx 40rpx;
}
.ph-eyebrow {
  display: block;
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: var(--gold-soft);
  margin-bottom: 12rpx;
}
.ph-h1 {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 14rpx;
}
.gold-em {
  color: var(--gold-soft);
}
.ph-lead {
  display: block;
  font-size: 24rpx;
  color: #b8c9c9;
  line-height: 1.7;
}

.map-diagram {
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.md-node {
  background: #103943;
  border: 1rpx solid #42616a;
  border-radius: 8rpx;
  padding: 14rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.md-t {
  font-size: 25rpx;
  font-weight: 700;
  color: #ffffff;
}
.md-s {
  font-size: 21rpx;
  color: #9eb4b5;
}
.md-center {
  background: #f8f6ef;
  color: #092d39;
  border: 2rpx solid var(--gold);
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mdc-t {
  font-size: 26rpx;
  font-weight: 700;
}
.mdc-s {
  font-size: 21rpx;
  color: #6c7260;
}

.side-index {
  display: block;
  font-size: 21rpx;
  color: var(--gold);
  font-weight: 700;
  letter-spacing: 1rpx;
}
.side-h3 {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--navy);
  margin: 8rpx 0 12rpx;
}
.role-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}
.rt-chip {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 6rpx;
  background: #eef3f0;
  color: var(--teal);
  font-weight: 600;
}
.bullet-list {
  margin-top: 16rpx;
}
.bl-item {
  font-size: 24rpx;
  color: #3f585e;
  margin-bottom: 8rpx;
}

.dir-scope {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f3f6f4;
  border-radius: 8rpx;
  font-size: 24rpx;
}
.ds-k {
  font-weight: 700;
  color: var(--teal);
}
.ds-v {
  color: var(--text);
}

.proc-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 20rpx;
}
.proc-tab {
  background: #eaeee9;
  border: 1rpx solid #cfd7cf;
  border-radius: 8rpx;
  padding: 16rpx 10rpx;
  text-align: center;
}
.proc-tab.active {
  background: var(--navy);
  border-color: var(--navy);
  color: #ffffff;
}
.pt-num {
  display: block;
  font-size: 20rpx;
  color: var(--gold);
  font-weight: 700;
}
.proc-tab.active .pt-num {
  color: var(--gold-soft);
}
.pt-name {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 提纲与二维码卡片 */
.outline-card {
  background: #092d39;
  color: #f8f6ef;
}
.oc-step {
  display: block;
  font-size: 22rpx;
  letter-spacing: 1.5rpx;
  color: var(--gold-soft);
  font-weight: 700;
}
.outline-pre {
  background: #103945;
  border: 1rpx solid #3c5f68;
  border-radius: 8rpx;
  padding: 22rpx;
  margin-bottom: 22rpx;
  font-size: 24rpx;
  color: #d0dfdf;
  line-height: 1.85;
  white-space: pre-wrap;
}
.oc-hint {
  display: block;
  font-size: 20rpx;
  color: #8ba6a7;
  margin-top: 16rpx;
  line-height: 1.6;
}
.qr-contact-card {
  text-align: center;
}
.ops-qr-img {
  width: 380rpx;
  height: 460rpx;
  margin: 20rpx auto 12rpx;
  display: block;
  border-radius: 10rpx;
  border: 1rpx solid var(--border);
}
.qr-tip {
  display: block;
  font-size: 22rpx;
  color: var(--teal);
  font-weight: 600;
}
